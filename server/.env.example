# ---------------------------------------------------------------
# Server-side configuration (copy to server/.env). These values are
# SECRET. They must never be committed or placed in frontend code.
# ---------------------------------------------------------------

PORT=5050
NODE_ENV=production

# Comma-separated list of origins allowed to call the API from a browser.
# Only needed when the website is hosted on a different domain from the API.
ALLOWED_ORIGINS=

# Set to true to let this server also serve the built website from ../dist
SERVE_STATIC=true

# Number of reverse proxies in front of this server (e.g. Nginx = 1).
# Needed for correct client IPs in rate limiting.
TRUST_PROXY=1

# --- Email delivery (SMTP) -------------------------------------
# Submissions are delivered by email ONLY when all of these are set.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address, e.g. "DEERA ENTERPRISES Website <no-reply@your-domain>"
SMTP_FROM=
# Inbox(es) that receive submissions, comma separated
SUBMISSIONS_TO=

# --- Optional spam protection: Cloudflare Turnstile ------------
# When set, every submission must carry a valid Turnstile token.
TURNSTILE_SECRET_KEY=
