# ---------------------------------------------------------------
# Frontend build variables (copy to .env). These are PUBLIC values:
# they are compiled into the browser bundle. Never put secrets here.
# ---------------------------------------------------------------

# Public URL of the live website (no trailing slash). Used for canonical
# URLs, sitemap.xml, robots.txt and social sharing metadata.
VITE_SITE_URL=https://www.example.com

# Base URL of the submission API. Leave empty when the Express server
# serves the website and API from the same domain (recommended).
VITE_API_BASE_URL=

# Optional: Cloudflare Turnstile SITE key (public). Must be paired with
# TURNSTILE_SECRET_KEY in server/.env.
VITE_TURNSTILE_SITE_KEY=
